{
  "name": "Wind Turbine Monitoring Dark",
  "dataColors": [
    "#3987e5",
    "#d95926",
    "#199e70",
    "#c98500",
    "#d55181",
    "#008300",
    "#9085e9",
    "#e66767"
  ],
  "background": "#0d0d0d",
  "foreground": "#ffffff",
  "tableAccent": "#3987e5",
  "good": "#0ca30c",
  "neutral": "#898781",
  "bad": "#e66767",
  "maximum": "#9ec5f4",
  "center": "#5598e7",
  "minimum": "#184f95",
  "textClasses": {
    "callout": {
      "fontFace": "Segoe UI",
      "color": "#ffffff",
      "fontSize": 40
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "color": "#ffffff",
      "fontSize": 12
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "color": "#c3c2b7",
      "fontSize": 10
    },
    "label": {
      "fontFace": "Segoe UI",
      "color": "#c3c2b7",
      "fontSize": 10
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#1a1a19" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#2c2c2a" } },
            "radius": 8
          }
        ],
        "dropShadow": [
          { "show": false }
        ],
        "title": [
          {
            "fontColor": { "solid": { "color": "#ffffff" } },
            "background": { "solid": { "color": "#1a1a19" } },
            "bold": true,
            "fontSize": 12
          }
        ]
      }
    },
    "columnChart": {
      "*": {
        "dataPoint": [
          { "defaultColor": { "solid": { "color": "#3987e5" } } }
        ]
      }
    },
    "barChart": {
      "*": {
        "dataPoint": [
          { "defaultColor": { "solid": { "color": "#3987e5" } } }
        ]
      }
    },
    "lineChart": {
      "*": {
        "dataPoint": [
          { "defaultColor": { "solid": { "color": "#3987e5" } } }
        ]
      }
    },
    "lineClusteredColumnComboChart": {
      "*": {
        "dataPoint": [
          { "defaultColor": { "solid": { "color": "#898781" } } }
        ]
      }
    },
    "pieChart": {
      "*": {
        "dataPoint": [
          { "defaultColor": { "solid": { "color": "#3987e5" } } }
        ]
      }
    }
  }
}
