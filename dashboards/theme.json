{
  "name": "Wind Turbine Monitoring",
  "dataColors": [
    "#2a78d6",
    "#eb6834",
    "#898781",
    "#1baf7a",
    "#eda100",
    "#e87ba4",
    "#4a3aa7",
    "#e34948"
  ],
  "background": "#fcfcfb",
  "foreground": "#0b0b0b",
  "tableAccent": "#2a78d6",
  "good": "#0ca30c",
  "neutral": "#898781",
  "bad": "#d03b3b",
  "maximum": "#0d366b",
  "center": "#6da7ec",
  "minimum": "#cde2fb",
  "textClasses": {
    "callout": {
      "fontFace": "Segoe UI",
      "color": "#0b0b0b",
      "fontSize": 40
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "color": "#0b0b0b",
      "fontSize": 12
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "color": "#52514e",
      "fontSize": 10
    },
    "label": {
      "fontFace": "Segoe UI",
      "color": "#52514e",
      "fontSize": 10
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#fcfcfb" } },
            "transparency": 0
          }
        ],
        "border": [
          { "show": false }
        ],
        "dropShadow": [
          { "show": false }
        ],
        "title": [
          {
            "fontColor": { "solid": { "color": "#0b0b0b" } },
            "background": { "solid": { "color": "#fcfcfb" } },
            "bold": true,
            "fontSize": 12
          }
        ]
      }
    },
    "columnChart": {
      "*": {
        "dataPoint": [
          { "defaultColor": { "solid": { "color": "#2a78d6" } } }
        ]
      }
    },
    "barChart": {
      "*": {
        "dataPoint": [
          { "defaultColor": { "solid": { "color": "#2a78d6" } } }
        ]
      }
    },
    "lineChart": {
      "*": {
        "dataPoint": [
          { "defaultColor": { "solid": { "color": "#2a78d6" } } }
        ]
      }
    },
    "lineClusteredColumnComboChart": {
      "*": {
        "dataPoint": [
          { "defaultColor": { "solid": { "color": "#898781" } } }
        ]
      }
    }
  }
}
